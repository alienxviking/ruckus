{
  "name": "ruckus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,party -c magenta,cyan \"next dev\" \"wrangler dev --port 1999\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev",
    "dev:party": "wrangler dev --port 1999",
    "typecheck": "tsc --noEmit && tsc --noEmit -p party",
    "deploy:party": "wrangler deploy",
    "test": "node scripts/test-all.mjs",
    "e2e": "npx tsx scripts/e2e-games.mjs",
    "types:worker": "wrangler types party/worker-configuration.d.ts",
    "covers": "tsx scripts/gen-covers.tsx"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.6",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.58.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
