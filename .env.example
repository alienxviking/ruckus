# Where the browser finds the PartyKit server.
# Leave unset in development: it defaults to <current hostname>:1999,
# which also works when you open the site from a phone on your Wi-Fi.
# In production set it to your deployed PartyKit host, e.g.
# NEXT_PUBLIC_PARTYKIT_HOST=ruckus.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=
